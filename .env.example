# MarketPulse TV — Environment Variables
# Copy this file to .env and fill in your credentials

# Alpaca Markets (https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://data.alpaca.markets

# CoinGecko (https://coingecko.com/en/api)
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# AI News Summarization — provide at least one
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# News source (NewsAPI for raw headlines that get AI-summarized)
NEWSAPI_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2

# App Config
PORT=3000
NODE_ENV=development
API_BASE_URL=https://your-vercel-url.vercel.app

# Cache TTLs (seconds)
CACHE_TTL_STOCKS=30
CACHE_TTL_CRYPTO=30
CACHE_TTL_NEWS=300
CACHE_TTL_MOVERS=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Amazon IAP (Fire TV) — NOT an env var.
# Amazon's IAP integration uses a public key file (AppstoreAuthenticationKey.pem)
# placed at apps/firetv/android/app/src/main/assets/ at native build time.
# Download it from your app's Amazon Developer Console listing.
# See apps/firetv/assets/README.md for the staging location and move instructions.

# Roku (set in Roku Developer Dashboard — not in code)
# ROKU_BILLING and RAF are configured in BrightScript manifest
