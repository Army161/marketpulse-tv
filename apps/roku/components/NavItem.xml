<?xml version="1.0" encoding="utf-8" ?>
<component name="NavItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/NavItem.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentSet" />
        <field id="width" type="float" />
        <field id="height" type="float" />
        <field id="focusPercent" type="float" onChange="onFocusSet" />
    </interface>

    <children>
        <!-- Focus treatment: gold accent bar + frosted glass pill + label all share
             the SAME vertical band (y 6..78, center 42) inside the 84px row, and the
             label is vertically centered via vertAlign so text can never drift off the
             pill regardless of font metrics. -->
        <Poster id="glass" uri="pkg:/images/glass_focus.9.png"
                width="278" height="72" translation="[12,6]" visible="false" />
        <Rectangle id="focusBar" color="0xF7C948FF" width="6" height="72" translation="[0,6]" visible="false" />
        <Label id="label" color="0x94A3B8FF" font="font:MediumBoldSystemFont"
               translation="[40,6]" width="240" height="72"
               horizAlign="left" vertAlign="center" />
    </children>
</component>
