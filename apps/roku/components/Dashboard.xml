<?xml version="1.0" encoding="utf-8" ?>
<component name="Dashboard" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/Dashboard.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <children>
        <Poster id="bg" uri="pkg:/images/bg_gradient_fhd.png" width="1920" height="1080" />

        <!-- Content stage: a translucent scrim over the content band (right of the nav,
             below the header divider) that tames the hero image's bright upper-center
             glow so headlines, the gauge, and body text stay legible on every page.
             Header + nav keep the full cinematic background. -->
        <Rectangle id="contentScrim" color="0x0A0E14A6" width="1620" height="810" translation="[300,150]" />

        <!-- ===== HEADER ===== -->
        <Label id="logo" text="MARKETPULSE" color="0xF7C948FF"
               font="font:LargeBoldSystemFont" translation="[330,40]" />
        <Label id="logoSub" text="LIVE FINANCE NETWORK" color="0x64748BFF"
               font="font:SmallBoldSystemFont" translation="[332,104]" />
        <Rectangle id="liveDot" color="0xF43F5EFF" width="16" height="16" translation="[1500,58]" />
        <Label id="liveTxt" text="LIVE" color="0xFFFFFFFF" font="font:SmallBoldSystemFont" translation="[1524,52]" />
        <Label id="clock" text="" color="0x94A3B8FF" font="font:MediumBoldSystemFont"
               translation="[1610,50]" width="270" horizAlign="right" />
        <Label id="fngMini" text="" color="0x94A3B8FF" font="font:SmallSystemFont"
               translation="[1610,96]" width="270" horizAlign="right" />
        <Poster id="headerLine" uri="pkg:/images/accent_line.png" width="1590" height="4" translation="[330,142]" />

        <!-- ===== NAV SIDEBAR ===== -->
        <NavSidebar id="nav" translation="[0,0]" />

        <!-- ===== PAGE: HOME ===== -->
        <Group id="dashGroup">
            <Label text="TOP GAINERS" color="0x34D399FF" font="font:MediumBoldSystemFont" translation="[330,180]" />
            <Group id="gainers" translation="[330,232]" />
            <Label text="TOP LOSERS" color="0xF43F5EFF" font="font:MediumBoldSystemFont" translation="[330,470]" />
            <Group id="losers" translation="[330,522]" />
            <FearGreedGauge id="gauge" translation="[1060,190]" />
            <Label text="LATEST HEADLINES" color="0x94A3B8FF" font="font:MediumBoldSystemFont" translation="[1060,470]" />
            <Group id="teaser" translation="[1060,522]" />
            <!-- AI Audio Anchor entry point. RIGHT from the sidebar focuses it; OK opens the brief. -->
            <!-- Custom styled button — avoids the Roku native Button checkbox appearance. -->
            <Group id="briefBtn" translation="[330,800]">
                <Rectangle id="briefBtnBg" color="0xF7C94822" width="320" height="60" />
                <Rectangle id="briefBtnBorder" color="0xF7C948FF" width="320" height="2" translation="[0,0]" />
                <Rectangle id="briefBtnBorderB" color="0xF7C948FF" width="320" height="2" translation="[0,58]" />
                <Rectangle id="briefBtnBorderL" color="0xF7C948FF" width="2" height="60" translation="[0,0]" />
                <Rectangle id="briefBtnBorderR" color="0xF7C948FF" width="2" height="60" translation="[318,0]" />
                <Label id="briefBtnLabel" text="▶  Daily Brief" color="0xF7C948FF"
                       font="font:MediumBoldSystemFont" translation="[24,14]" />
            </Group>
        </Group>

        <!-- ===== PAGE: CRYPTO ===== -->
        <Group id="cryptoGroup" visible="false">
            <Label text="CRYPTO  •  TOP 20" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" translation="[330,180]" />
            <AssetList id="cryptoList" translation="[330,236]" />
        </Group>

        <!-- ===== PAGE: STOCKS ===== -->
        <Group id="stocksGroup" visible="false">
            <Label text="STOCKS  •  TOP 20" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" translation="[330,180]" />
            <AssetList id="stocksList" translation="[330,236]" />
        </Group>

        <!-- ===== PAGE: NEWS ===== -->
        <Group id="newsGroup" visible="false">
            <Label text="MARKET NEWS" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" translation="[330,180]" />
            <NewsPanel id="newsPanel" translation="[330,236]" />
        </Group>

        <!-- ===== PAGE: CALENDAR ===== -->
        <Group id="calendarGroup" visible="false">
            <Label text="EARNINGS CALENDAR  •  YOUR TICKERS" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" translation="[330,180]" />
            <CalendarList id="calendarList" translation="[330,236]" />
        </Group>

        <!-- ===== PAGE: SENTIMENT ===== -->
        <Group id="sentimentGroup" visible="false">
            <Label text="MARKET SENTIMENT" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" translation="[330,180]" />
            <Poster id="sentGlass" uri="pkg:/images/glass_panel.9.png" width="1180" height="600" translation="[330,236]" />
            <FearGreedGauge id="gauge2" translation="[400,300]" />
            <Label id="sentExplain" color="0xCBD5E1FF" font="font:MediumSystemFont"
                   translation="[400,560]" width="1040" wrap="true" maxLines="5" />
        </Group>

        <!-- ===== PAGE: SETTINGS ===== -->
        <Group id="settingsGroup" visible="false">
            <Label text="SETTINGS" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" translation="[330,180]" />
            <Poster id="setGlass" uri="pkg:/images/glass_panel.9.png" width="1180" height="600" translation="[330,236]" />
            <Group id="settingsRows" translation="[392,300]" />
        </Group>

        <!-- ===== PAGE: UPGRADE ===== -->
        <Group id="upgradeGroup" visible="false">
            <Label text="UPGRADE  •  GO PREMIUM" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" translation="[330,180]" />
            <Group id="pricingCards" translation="[330,236]" />
        </Group>

        <!-- ===== CHYRON TICKER ===== -->
        <TickerRow id="ticker" translation="[0,984]" />
        <Label id="status" text="" color="0x64748BFF" font="font:SmallestSystemFont" translation="[330,950]" />

        <!-- ===== DETAIL OVERLAY ===== -->
        <DetailOverlay id="overlay" />

        <!-- ===== AI MARKET BRIEF OVERLAY ===== -->
        <BriefOverlay id="briefOverlay" />
    </children>
</component>
