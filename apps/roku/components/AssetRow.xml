<?xml version="1.0" encoding="utf-8" ?>
<component name="AssetRow" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/AssetRow.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentSet" />
        <field id="width" type="float" onChange="onSizeSet" />
        <field id="height" type="float" />
        <field id="focusPercent" type="float" onChange="onFocusSet" />
    </interface>

    <children>
        <Rectangle id="rowBg" color="0x111B2B00" width="820" height="64" />
        <Rectangle id="focusBar" color="0xFFB800FF" width="6" height="64" visible="false" />
        <Label id="sym"   color="0xFFFFFFFF" font="font:MediumBoldSystemFont" translation="[28,16]"  width="220" />
        <Label id="price" color="0x9AA7BCFF" font="font:MediumSystemFont"     translation="[300,18]" width="240" />
        <Label id="chg"   color="0x00E58FFF" font="font:MediumBoldSystemFont" translation="[600,18]" width="200"
               horizAlign="right" />
    </children>
</component>
