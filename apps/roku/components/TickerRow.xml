<?xml version="1.0" encoding="utf-8" ?>
<component name="TickerRow" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/TickerRow.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

    <interface>
        <function name="setData" />
    </interface>

    <children>
        <Poster id="chyronBg" uri="pkg:/images/chyron_bg.png" width="1920" height="96" />
        <Poster id="accent" uri="pkg:/images/accent_line.png" width="1920" height="4" translation="[0,0]" />
        <!-- "LIVE MARKETS" badge on the left rail of the chyron -->
        <Rectangle id="badge" color="0xFFB800FF" width="220" height="96" translation="[0,0]">
            <Label id="badgeText" text="● LIVE MARKETS" color="0x05070BFF"
                   font="font:SmallBoldSystemFont" translation="[18,36]" width="200" />
        </Rectangle>
        <!-- The moving content lives in this group; we animate its translation. -->
        <Group id="content" translation="[240,0]" />
    </children>
</component>
